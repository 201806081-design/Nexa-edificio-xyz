# URL base de la API del backend
VITE_API_BASE_URL="http://localhost:4000/api"

# Envio de credenciales por correo: "true" cuando el backend tenga POST /api/correo/credenciales.
# Mientras este en "false" el envio se simula.
VITE_CORREO_BACKEND="false"

# Permisos por rol: "true" cuando el backend tenga GET /api/permisos y PUT /api/permisos/:rol.
# Mientras este en "false" se usan los permisos de prueba (constants/permisos.js).
VITE_PERMISOS_BACKEND="false"

# Entorno
VITE_APP_ENV="development"
