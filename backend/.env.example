# ---------- Base de datos ----------
# Staging/producción (Neon PostgreSQL):
DATABASE_URL="postgresql://usuario:password@ep-xxxx.neon.tech/nexa_edificio?sslmode=require"
# Desarrollo local (Postgres.app en Mac, sin contraseña):
# DATABASE_URL="postgresql://TU_USUARIO_MAC@localhost:5432/nexa_edificio?schema=public"
# Desarrollo local (docker-compose.yml de la raíz):
# DATABASE_URL="postgresql://nexa:nexa@localhost:5432/nexa_edificio_local?schema=public"

# ---------- Servidor ----------
PORT=8000
NODE_ENV=development
# Orígenes permitidos para CORS separados por coma ("*" en desarrollo)
CORS_ORIGIN="*"

# ---------- Autenticación ----------
JWT_SECRET="reemplazar-por-un-valor-seguro"
JWT_EXPIRES_IN="8h"

# ---------- Almacenamiento de archivos (Gestión Documental) ----------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- Envío de comunicados por correo ----------
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
