            },
            "url": "{{baseUrl}}/financiero/pagos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 y asiento cuadrado', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const d = pm.response.json().data;",
                  "  pm.expect(d.asiento.totalDebe).to.eql(d.asiento.totalHaber);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar pago · DEP-301 con cobro de mora",
          "request": {
            "method": "POST",
            "header": [
